# ../isonim/docs/users -- task entry points (mirrors ../../../isonim-docs/Justfile's style).
#
# Every recipe assumes the IsoNim dev shell is active. From a clean checkout:
#   nix develop ../isonim -c just --justfile docs/users/Justfile --working-directory docs/users test

test:
    nim c -r tests/test_site_builds.nim
    nim c -r tests/test_completeness.nim
    nim c -r tests/test_content_loader.nim
    nim c -r tests/test_manifest_from_content.nim
    nim c -r tests/test_docs_graph_integration.nim
    nim c -r tests/test_references.nim
    nim c -r tests/test_redirects.nim
    nim c -r tests/test_proofsite_examples_compile.nim
    nim c -r tests/test_theme_contract.nim
    nim c -r tests/test_landing_components.nim
    nim c -r tests/test_dev.nim

build:
    nim c -r --hints:off -o:build/build src/build.nim

# Live-reloading dev server: serves content/ + the themed assets and hot-reloads
# every open tab on any content edit. Run this, then `just open` in another shell.
dev port='8000':
    nim c -r --hints:off src/dev.nim {{port}}

# Open the running dev server in a browser (portable: Linux xdg-open / macOS open).
open port='8000':
    @xdg-open http://localhost:{{port}}/ 2>/dev/null || open http://localhost:{{port}}/ 2>/dev/null || echo "open http://localhost:{{port}}/ manually"

# One-shot SSR preview (no live reload).
serve:
    nim c -r --hints:off src/ssr.nim
