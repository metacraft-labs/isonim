# Resolve flake inputs from the declared workspace develop set, matching
# useFlakeDevShell() in repro.nim. A checked-out sibling without its own
# published lock stays on the committed flake.lock pin.
dotenv_if_exists .env
watch_file .env

# Hook constructors are evaluated from these tracked shell dependencies.
watch_file nix/hook-ownership-guard.py
watch_file nix/hook-transaction.py
watch_file nix/filter-workspace-flake-overrides.sh

# Refuse stale or unresolved environments rather than silently using pinned
# inputs after an override resolver failure.
nix_direnv_disallow_fallback || exit $?
_repro_flake_resolver="${REPROBUILD_REPRO:-${REPRO_INVOKING_CLI:-repro}}"
_repro_flake_args="$("$_repro_flake_resolver" flake override-args --all)" || exit $?
# The hook constructor is a fixed tool role, not a develop-mode sibling.
# Filter the single canonical resolver result; preserve all other inputs.
source nix/filter-workspace-flake-overrides.sh || exit $?
_isonim_filter_workspace_overrides "$_repro_flake_args" || exit $?
use flake . "${_isonim_flake_words[@]}" || exit $?
unset _repro_flake_args _repro_flake_resolver _isonim_flake_words
unset -f _isonim_filter_workspace_overrides
